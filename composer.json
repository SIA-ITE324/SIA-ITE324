{
    "name": "fleur/flower-order-management",
    "description": "Flower Order Management System using CodeIgniter 4",
    "type": "project",
    "keywords": ["codeigniter", "flower", "order", "management", "php"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.4",
        "codeigniter4/appstarter": "^4.4",
        "phpoffice/phpspreadsheet": "^1.29",
        "brevo/brevo-php": "^2.0",
        "intervention/image": "^2.7"
    },
    "require-dev": {
        "codeigniter4/devkit": "^1.0",
        "phpunit/phpunit": "^10.1",
        "mockery/mockery": "^1.5"
    },
    "suggest": {
        "ext-fileinfo": "Improves mime type detection for files",
        "ext-intl": "Allows the creation of Locale aware applications",
        "ext-mbstring": "For improved UTF-8 string handling",
        "ext-openssl": "For secure encryption and signing"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@composer dump-autoload"
        ],
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
